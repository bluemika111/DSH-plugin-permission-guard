{
  "name": "dsh-outsideread-switch",
  "version": "2.0.0",
  "private": false,
  "description": "Tool-layer fence for one dimension the harness sandbox does not have: whether the model may READ outside the session workspace. Writes stay the sandbox's business. Includes a locale-aware composer switch.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "permissions",
    "sandbox",
    "security"
  ],
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-outsideread-switch": "bin/install.js"
  },
  "files": [
    "index.js",
    "modes.js",
    "client.js",
    "cordis.patch.yml",
    "bin/install.js",
    "README.md",
    "Development process.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/test-matrix.js && node test/test-boot-safety.js && node test/test-client-contract.js && node test/test-module-resolution.js && node test/probe-route-disclosure.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": {
    "name": "bluemika",
    "email": "huang20080115@outlook.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluemika111/dsh-outsideread-switch.git"
  },
  "bugs": {
    "url": "https://github.com/bluemika111/dsh-outsideread-switch/issues"
  },
  "homepage": "https://github.com/bluemika111/dsh-outsideread-switch#readme",
  "publishConfig": {
    "access": "public"
  }
}
